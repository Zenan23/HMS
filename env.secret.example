# Dijeljena Docker konfiguracija za lokalni/dev rad — TEMPLATE (komitovan u git).
#
# Ovo je samo šablon sa placeholder vrijednostima. Stvarni fajl sa pravim tajnama
# je `env.secret` (BEZ .example nastavka) — taj fajl je u .gitignore i NIKAD se ne
# commituje. Postupak:
#   1. cp env.secret.example env.secret
#   2. Popuni prave vrijednosti u env.secret (Stripe sandbox ključevi, SMTP nalog).
#      Zatraži ih od člana tima koji ih već ima, ili ih generiši u odgovarajućem dashboardu.
#   3. API i Worker servisi u docker-compose.yml učitavaju env.secret preko `env_file:`.
#
# VAŽNO: sve varijable ovdje MORAJU biti u Payments__Sekcija__Kljuc / Smtp__Kljuc formatu
# (dvostruka donja crta) — tako ih ASP.NET Core konfiguracija čita (mapira se u
# Payments:Sekcija:Kljuc / Smtp:Kljuc). Vidi appsettings.json i Program.cs
# (builder.Services.Configure<PaymentOptions>/<SmtpOptions>).
#
# Infra tajne (DB lozinka, JWT ključ, RabbitMQ kredencijali) NISU ovdje — one dolaze iz
# root `.env` fajla (vidi .env.example) preko ${VAR} supstitucije u docker-compose.yml,
# jer trebaju i db/rabbitmq kontejnerima, ne samo api/worker.

# --- Plaćanja (Stripe sandbox) ---
Payments__UseHostedCheckout=true
Payments__EnableNativeCheckout=true

# Stripe Dashboard (test mode) → Developers → API keys — rotiraj ako su stare vrijednosti
# ikad bile commitovane (vidi TODO-uskladjenost-env-config.md).
Payments__Stripe__SecretKey=
Payments__Stripe__PublishableKey=
Payments__Stripe__WebhookSecret=
Payments__Stripe__SuccessUrl=ebooking://payment-return
Payments__Stripe__CancelUrl=ebooking://payment-cancel

# --- SMTP (reset lozinke) ---
# OBAVEZNO popuniti prije testiranja "zaboravljena lozinka" na mobilnoj app (npr. Gmail app
# password: https://myaccount.google.com/apppasswords, ili Mailtrap/Ethereal za dev testiranje).
# Dok je Smtp__Host prazan, aplikacija NE puca — samo loguje upozorenje i email se ne šalje.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__UseSsl=true
Smtp__FromEmail=
Smtp__FromName=eBooking
