# Root .env — Docker Compose ovaj fajl AUTOMATSKI učitava (isto ime, isti folder kao
# docker-compose.yml) za ${VAR} supstituciju u docker-compose.yml. Odvojen je od
# env.docker (koji se učitava kroz env_file: za api/worker kontejnere) jer OVI podaci
# trebaju i db/rabbitmq kontejnerima, ne samo api/worker.
#
# Postupak: cp .env.example .env — ovaj .env se NE commituje (vidi .gitignore).
#
# Ovo su SAMO placeholder vrijednosti (template) — nisu namijenjene za stvarno
# korištenje. Popuni .env svojim vrijednostima; MSSQL_SA_PASSWORD mora imati
# min. 8 karaktera i pokrivati bar 3 od 4 kategorije (veliko/malo slovo, broj,
# specijalni karakter), JWT_SECRET drži na 32+ karaktera.

MSSQL_SA_PASSWORD=ReplaceWith_YourOwn1!
JWT_SECRET=ReplaceWithYourOwnRandomSecretKey_AtLeast32Chars
RABBIT_USER=replace_me
RABBIT_PASS=replace_me
