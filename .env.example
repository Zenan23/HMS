# Kopiraj u .env u rootu repozitorija i popuni vrijednosti.
# docker compose automatski učitava .env (fajl .env ne commituj).

# --- Stripe (test / sandbox) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL na koji Stripe vraća korisnika nakon plaćanja (mora biti dostupan iz browsera)
STRIPE_SUCCESS_URL=http://localhost:8080/payment-return
STRIPE_CANCEL_URL=http://localhost:8080/payment-cancel

# --- PayPal (sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8080/payment-return
PAYPAL_CANCEL_URL=http://localhost:8080/payment-cancel

# --- Opcije plaćanja ---
PAYMENTS_USE_HOSTED_CHECKOUT=true
# Samo za lokalni dev bez PayPal webhook verifikacije (nije za produkciju)
PAYMENTS_SKIP_PAYPAL_WEBHOOK_VERIFICATION=false

# Postojeće (baza, JWT, Rabbit) – vidi docker-compose.yml
# MSSQL_SA_PASSWORD=
# JWT_SECRET=
# RABBIT_USER=
# RABBIT_PASS=
