# Dijeljena Docker konfiguracija za lokalni/dev rad.
# JEDINI env fajl u projektu — commitan u repo, nakon clone-a ne treba ništa dodatno
# kreirati niti popunjavati. Nema više .env override-a (ranije je koristio pogrešna imena
# varijabli poput STRIPE_SECRET_KEY koja se nikad nisu ni mapirala u konfiguraciju — tiho
# se ignorisala). API i Worker servisi učitavaju OVAJ fajl preko env_file u
# docker-compose.yml (vidi env_file: env.docker, required: true).
#
# VAŽNO: sve varijable ovdje MORAJU biti u Payments__Sekcija__Kljuc / Smtp__Kljuc formatu
# (dvostruka donja crta) — tako ih ASP.NET Core konfiguracija čita (mapira se u
# Payments:Sekcija:Kljuc / Smtp:Kljuc). Vidi appsettings.json i Program.cs
# (builder.Services.Configure<PaymentOptions>/<SmtpOptions>).

# --- Infra (baza/JWT/Rabbit) ---
# MSSQL_SA_PASSWORD, JWT_SECRET, RABBIT_USER, RABBIT_PASS se NE čitaju iz ovog fajla —
# to su Docker Compose ${VAR:-default} zamjene direktno u docker-compose.yml (koriste se
# i za db/rabbitmq kontejnere, ne samo za api/worker, pa ne mogu doći iz env_file-a).
# Defaulti (YourStrong@Passw0rd! / ChangeThisToAStrongSecretKey_AtLeast32Chars / guest / guest)
# već rade zero-config nakon clone-a — mijenjaj ih direktno u docker-compose.yml ako zatreba.

# --- Plaćanja (Stripe / PayPal sandbox) ---
Payments__UseHostedCheckout=true
Payments__EnableNativeCheckout=true
# true = lokalni dev bez PayPal webhooka (potvrda preko /Payments/paypal/capture)
Payments__SkipPayPalWebhookVerification=true

Payments__Stripe__SecretKey=sk_test_51ShHV6L5ZOkzEfLPrIrKAL8CXSs6Xb4fj8h3ekKh1nrL4GlhwsPkRtlaO6n3x2Q1pi8Y5pgiyCmv1ZsGX2PHdNAm004fjcCFPk
# OBAVEZNO: Stripe Dashboard → Developers → API keys → Publishable key (pk_test_…)
# Mora biti isti account kao SecretKey iznad. Placeholder/prazno = Stripe Element ne radi (401).
Payments__Stripe__PublishableKey=pk_test_51ShHV6L5ZOkzEfLP2R8xTyjUAZfDkzD2LsOdAvXGFQI8yrWmSh4SE7NmaX5YpIWukPMOvWDklsl8z7bdmXEEgFZe00rXnLIpl5
Payments__Stripe__WebhookSecret=whsec_7c943d4e93e16f2b70f3535d72d8c03fb9e21dab01ff77edb2e04e91d50bd84b
Payments__Stripe__SuccessUrl=ebooking://payment-return
Payments__Stripe__CancelUrl=ebooking://payment-cancel

# PayPal sandbox — popuni ClientId/Secret timskim sandbox kredencijalima (isti za sve kolege)
Payments__PayPal__ClientId=AYNbjzh_bjMb5ReCw9IuUXxcaJGAaCPZJsGA4QKEnqMyAKl1nm1a63GL-4TqcB-Mtc6jDxAY5HJM3rKC
Payments__PayPal__ClientSecret=EGjEWlT4xPfDLDtCpwbe4Z08LwP3_3F5U-ldbwAWUHTBwmyGwzphkcWHeqr2DiW3QBaV9AoHXYy6sHFB
Payments__PayPal__WebhookId=
Payments__PayPal__BaseUrl=https://api-m.sandbox.paypal.com
Payments__PayPal__ReturnUrl=ebooking://payment-return
Payments__PayPal__CancelUrl=ebooking://payment-cancel

# --- SMTP (reset lozinke) ---
# OBAVEZNO popuniti prije testiranja "zaboravljena lozinka" na mobilnoj app (npr. Gmail app
# password: https://myaccount.google.com/apppasswords, ili Mailtrap/Ethereal za dev testiranje).
# Dok je Smtp__Host prazan, aplikacija NE puca — samo loguje upozorenje i email se ne šalje.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__UseSsl=true
Smtp__FromEmail=
Smtp__FromName=eBooking
